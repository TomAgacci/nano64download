10 REM === NANO64 MSPAINT DELUXE ===
20 REM FEATURES:
21 REM - BRUSH SIZES
22 REM - SPRAY CAN
23 REM - LINE / RECT / CIRCLE
24 REM - SAVE/LOAD TO .PULSE MEMORY
25 REM - COLOR PICKER
26 REM - SCROLLING CANVAS (LOGICAL)
27 REM - ANIMATED BRUSHES

30 GOSUB 1000 : REM INIT
40 GOSUB 2000 : REM DRAW UI
50 GOSUB 3000 : REM MAIN LOOP
60 END

1000 REM === INIT ===
1010 CANVASX=3 : CANVASY=3
1020 CURX=CANVASX : CURY=CANVASY
1030 COLOR=5
1040 TOOL=0 : REM 0=PEN,1=ERASE,2=FILL,3=SPRAY,4=LINE,5=RECT,6=CIRCLE
1050 BRUSH=1 : REM 1,2,3
1060 ANIM=0 : REM animated brush toggle
1070 SCROLLX=0 : SCROLLY=0
1080 FIRST=0
1090 RETURN

2000 REM === DRAW UI ===
2010 REM PALETTE BAR (TOP, COLORS 0–7)
2020 FOR I=0 TO 7
2030   LOCATE I,0 : PRINT CHR$(219);
2040 NEXT I

2050 REM TOOL LABELS
2060 LOCATE 10,0 : PRINT "PEN ";
2070 LOCATE 14,0 : PRINT "ERASE";
2080 LOCATE 20,0 : PRINT "FILL ";
2090 LOCATE 26,0 : PRINT "SPRAY";
2100 LOCATE 32,0 : PRINT "LINE ";
2110 LOCATE 38,0 : PRINT "RECT ";
2120 LOCATE 44,0 : PRINT "CIRC ";

2130 REM BRUSH SIZE
2140 LOCATE 50,0 : PRINT "BR:";BRUSH;

2150 REM ANIMATED BRUSH
2160 LOCATE 56,0 : PRINT "AN:";ANIM;

2170 REM CANVAS BORDER (28x20 tiles)
2180 FOR X=CANVASX-1 TO CANVASX+28
2190   LOCATE X,CANVASY-1 : PRINT CHR$(219);
2200   LOCATE X,CANVASY+20: PRINT CHR$(219);
2210 NEXT X
2220 FOR Y=CANVASY-1 TO CANVASY+20
2230   LOCATE CANVASX-1,Y : PRINT CHR$(219);
2240   LOCATE CANVASX+28,Y: PRINT CHR$(219);
2250 NEXT Y
2260 RETURN

3000 REM === MAIN LOOP ===
3010 K$=INKEY$
3020 IF K$="" THEN GOTO 3500

3030 REM MOVE CURSOR
3040 IF K$=CHR$(28) THEN CURX=CURX-1
3050 IF K$=CHR$(29) THEN CURX=CURX+1
3060 IF K$=CHR$(30) THEN CURY=CURY-1
3070 IF K$=CHR$(31) THEN CURY=CURY+1

3080 REM CLAMP TO CANVAS
3090 IF CURX<CANVASX THEN CURX=CANVASX
3100 IF CURX>CANVASX+27 THEN CURX=CANVASX+27
3110 IF CURY<CANVASY THEN CURY=CANVASY
3120 IF CURY>CANVASY+19 THEN CURY=CANVASY+19

3130 REM COLOR PICKER
3140 IF K$="C" THEN GOSUB 7000

3150 REM BRUSH SIZE
3160 IF K$="B" THEN BRUSH=BRUSH+1:IF BRUSH>3 THEN BRUSH=1:LOCATE 53,0:PRINT BRUSH;

3170 REM ANIMATED BRUSH
3180 IF K$="A" THEN ANIM=1-ANIM:LOCATE 59,0:PRINT ANIM;

3190 REM SELECT TOOL
3200 IF K$="P" THEN TOOL=0
3210 IF K$="E" THEN TOOL=1
3220 IF K$="F" THEN TOOL=2
3230 IF K$="S" THEN TOOL=3
3240 IF K$="L" THEN TOOL=4
3250 IF K$="R" THEN TOOL=5
3260 IF K$="O" THEN TOOL=6

3270 REM DRAW / ACTION
3280 IF K$=" " THEN GOSUB 4000

3290 REM SAVE / LOAD
3300 IF K$="Z" THEN GOSUB 8000
3310 IF K$="X" THEN GOSUB 8100

3500 GOSUB 3600
3510 GOTO 3010

3600 REM === DRAW CURSOR (SIMPLE OVERLAY) ===
3610 LOCATE CURX,CURY : PRINT CHR$(176);
3620 RETURN

4000 REM === APPLY TOOL DISPATCH ===
4010 IF TOOL=0 THEN GOSUB 4100 : RETURN
4020 IF TOOL=1 THEN GOSUB 4200 : RETURN
4030 IF TOOL=2 THEN GOSUB 4300 : RETURN
4040 IF TOOL=3 THEN GOSUB 4400 : RETURN
4050 IF TOOL=4 THEN GOSUB 4500 : RETURN
4060 IF TOOL=5 THEN GOSUB 4600 : RETURN
4070 IF TOOL=6 THEN GOSUB 4700 : RETURN
4080 RETURN

4100 REM === PEN (BRUSH + ANIM) ===
4110 FOR DY=-BRUSH TO BRUSH
4120   FOR DX=-BRUSH TO BRUSH
4130     IF DX*DX+DY*DY<=BRUSH*BRUSH THEN
4140       X=CURX+DX : Y=CURY+DY
4150       IF X>=CANVASX AND X<=CANVASX+27 AND Y>=CANVASY AND Y<=CANVASY+19 THEN
4160         IF ANIM=1 THEN C=INT(RND(1)*7)+1 ELSE C=COLOR
4170         POKE VRAM+(Y*32+X),C
4180       END IF
4190     END IF
4200   NEXT DX
4210 NEXT DY
4220 RETURN

4200 REM === ERASER ===
4210 FOR DY=-BRUSH TO BRUSH
4220   FOR DX=-BRUSH TO BRUSH
4230     X=CURX+DX : Y=CURY+DY
4240     IF X>=CANVASX AND X<=CANVASX+27 AND Y>=CANVASY AND Y<=CANVASY+19 THEN
4250       POKE VRAM+(Y*32+X),0
4260     END IF
4270   NEXT DX
4280 NEXT DY
4290 RETURN

4300 REM === FLOOD FILL ===
4310 TARGET=PEEK(VRAM+(CURY*32+CURX))
4320 IF TARGET=COLOR THEN RETURN
4330 GOSUB 4400
4340 RETURN

4400 REM === FLOOD FILL ROUTINE ===
4410 DIM SX(500),SY(500)
4420 SP=0
4430 SX(0)=CURX : SY(0)=CURY
4440 WHILE SP>=0
4450   X=SX(SP) : Y=SY(SP) : SP=SP-1
4460   IF X<CANVASX OR X>CANVASX+27 OR Y<CANVASY OR Y>CANVASY+19 THEN GOTO 4500
4470   IF PEEK(VRAM+(Y*32+X))<>TARGET THEN GOTO 4500
4480   POKE VRAM+(Y*32+X),COLOR
4490   SP=SP+1 : SX(SP)=X+1 : SY(SP)=Y
4491   SP=SP+1 : SX(SP)=X-1 : SY(SP)=Y
4492   SP=SP+1 : SX(SP)=X : SY(SP)=Y+1
4493   SP=SP+1 : SX(SP)=X : SY(SP)=Y-1
4500 WEND
4510 RETURN

4400 REM === SPRAY CAN ===
4520 FOR I=1 TO 20
4530   DX=INT(RND(1)*BRUSH*2)-BRUSH
4540   DY=INT(RND(1)*BRUSH*2)-BRUSH
4550   IF DX*DX+DY*DY<=BRUSH*BRUSH THEN
4560     X=CURX+DX : Y=CURY+DY
4570     IF X>=CANVASX AND X<=CANVASX+27 AND Y>=CANVASY AND Y<=CANVASY+19 THEN
4580       POKE VRAM+(Y*32+X),COLOR
4590     END IF
4600   END IF
4610 NEXT I
4620 RETURN

4500 REM === LINE TOOL ===
4630 IF FIRST=0 THEN X1=CURX:Y1=CURY:FIRST=1:RETURN
4640 X2=CURX:Y2=CURY:FIRST=0
4650 DX=ABS(X2-X1):DY=ABS(Y2-Y1)
4660 IF X2>=X1 THEN SX=1 ELSE SX=-1
4670 IF Y2>=Y1 THEN SY=1 ELSE SY=-1
4680 ERR=DX-DY
4690 WHILE X1<>X2 OR Y1<>Y2
4700   IF X1>=CANVASX AND X1<=CANVASX+27 AND Y1>=CANVASY AND Y1<=CANVASY+19 THEN
4710     POKE VRAM+(Y1*32+X1),COLOR
4720   END IF
4730   E2=ERR*2
4740   IF E2>-DY THEN ERR=ERR-DY:X1=X1+SX
4750   IF E2<DX THEN ERR=ERR+DX:Y1=Y1+SY
4760 WEND
4770 RETURN

4600 REM === RECTANGLE TOOL ===
4780 IF FIRST=0 THEN X1=CURX:Y1=CURY:FIRST=1:RETURN
4790 X2=CURX:Y2=CURY:FIRST=0
4800 IF X2<X1 THEN T=X1:X1=X2:X2=T
4810 IF Y2<Y1 THEN T=Y1:Y1=Y2:Y2=T
4820 FOR X=X1 TO X2
4830   IF Y1>=CANVASY AND Y1<=CANVASY+19 THEN POKE VRAM+(Y1*32+X),COLOR
4840   IF Y2>=CANVASY AND Y2<=CANVASY+19 THEN POKE VRAM+(Y2*32+X),COLOR
4850 NEXT X
4860 FOR Y=Y1 TO Y2
4870   IF X1>=CANVASX AND X1<=CANVASX+27 THEN POKE VRAM+(Y*32+X1),COLOR
4880   IF X2>=CANVASX AND X2<=CANVASX+27 THEN POKE VRAM+(Y*32+X2),COLOR
4890 NEXT Y
4900 RETURN

4700 REM === CIRCLE TOOL ===
4910 IF FIRST=0 THEN X1=CURX:Y1=CURY:FIRST=1:RETURN
4920 X2=CURX:Y2=CURY:FIRST=0
4930 R=SQR((X2-X1)*(X2-X1)+(Y2-Y1)*(Y2-Y1))
4940 A=0
4950 WHILE A<6.28
4960   X=INT(X1+COS(A)*R)
4970   Y=INT(Y1+SIN(A)*R)
4980   IF X>=CANVASX AND X<=CANVASX+27 AND Y>=CANVASY AND Y<=CANVASY+19 THEN
4990     POKE VRAM+(Y*32+X),COLOR
5000   END IF
5010   A=A+0.1
5020 WEND
5030 RETURN

7000 REM === COLOR PICKER ===
7010 COLOR=PEEK(VRAM+(CURY*32+CURX))
7020 RETURN

8000 REM === SAVE CANVAS TO .PULSE ===
8010 PRINT "PULSAVE:BEGIN;"
8020 FOR Y=CANVASY TO CANVASY+19
8030   FOR X=CANVASX TO CANVASX+27
8040     C=PEEK(VRAM+(Y*32+X))
8050     PRINT "PULSAVE:PIX=";X;",";Y;",";C;";"
8060   NEXT X
8070 NEXT Y
8080 PRINT "PULSAVE:END;"
8090 RETURN

8100 REM === LOAD CANVAS REQUEST ===
8110 PRINT "PULLOAD:REQ=1;"
8120 REM C-SIDE WILL STREAM PIX DATA BACK
8130 RETURN
