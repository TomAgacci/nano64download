10 REM === MSPAINT-ULTRA (RETRO-CLEAN) ===
20 REM LAYERS, BLEND, OPACITY, BRUSHES, SELECTION, UNDO, PROJECT
30 GOSUB 1000 : REM INIT
40 GOSUB 2000 : REM DRAW STATIC UI
50 GOSUB 3000 : REM MAIN LOOP
60 END

REM ------------------------------------------------------------
REM 1000–1999: INIT
REM ------------------------------------------------------------
1000 REM === INIT ===
1010 CANVASX=3:CANVASY=3
1020 CURX=CANVASX:CURY=CANVASY
1030 COLOR=5
1040 TOOL=0:REM 0=PEN,1=ERASE,2=FILL,3=SPRAY,4=LINE,5=RECT,6=CIRC
1050 BRUSH=1:BRUSHES=8
1060 BRUSHPRESET=0
1070 ANIM=0
1080 LAYERS=4
1090 DIM L(LAYERS,27,19)
1100 DIM OPACITY(LAYERS)
1110 DIM BLEND(LAYERS)
1120 FOR I=0 TO LAYERS-1
1130 OPACITY(I)=255:BLEND(I)=0
1140 NEXT I
1150 LAYER=0

1160 REM === UNDO SYSTEM ===
1170 UNDOLEVELS=32:MAXD=200
1180 UNDOPTR=0:REDOPTR=0
1190 DIM UX(UNDOLEVELS,MAXD),UY(UNDOLEVELS,MAXD)
1200 DIM UOLD(UNDOLEVELS,MAXD),UNEW(UNDOLEVELS,MAXD)
1210 DIM UCOUNT(UNDOLEVELS)
1220 DIM RX(UNDOLEVELS,MAXD),RY(UNDOLEVELS,MAXD)
1230 DIM ROLD(UNDOLEVELS,MAXD),RNEW(UNDOLEVELS,MAXD)
1240 DIM RCOUNT(UNDOLEVELS)

1250 REM === BRUSH SHAPES ===
1260 DIM B(BRUSHES,6,6)

1270 REM === SELECTION + COPY BUFFER ===
1280 DIM SEL(27,19),COPY(27,19)
1290 DIM LX(100),LY(100),XINTS(100)
1300 SELACTIVE=0:SELMODE=0:LCOUNT=0
1310 SX0=0:SY0=0:SX1=0:SY1=0:COPYW=0:COPYH=0

1320 REM === PROJECT VERSIONING ===
1330 VERSION=3:FLAGS=0
1340 FLAGS=FLAGS OR 1:FLAGS=FLAGS OR 4

1350 GOSUB 1500
1360 RETURN

1500 REM === CLEAR LAYERS ===
1510 FOR LID=0 TO LAYERS-1
1520 FOR Y=0 TO 19
1530 FOR X=0 TO 27
1540 L(LID,X,Y)=0
1550 NEXT X
1560 NEXT Y
1570 NEXT LID
1580 GOSUB 1600
1590 RETURN

1600 REM === COMPOSITE LAYERS (OPACITY + BLEND) ===
1610 FOR Y=0 TO 19
1620 FOR X=0 TO 27
1630 COUT=0
1640 FOR LID=0 TO LAYERS-1
1650 C=L(LID,X,Y)
1660 A=OPACITY(LID)

1670 IF BLEND(LID)=0 THEN CBL=C
1680 IF BLEND(LID)=1 THEN CBL=(COUT*C)\255
1690 IF BLEND(LID)=2 THEN CBL=255-((255-COUT)*(255-C)\255)
1700 IF BLEND(LID)=3 THEN IF COUT<128 THEN CBL=(2*COUT*C)\255 ELSE CBL=255-(2*(255-COUT)*(255-C)\255)

1710 COUT=(COUT*(255-A)+CBL*A)\255
1720 NEXT LID

1730 POKE VRAM+((CANVASY+Y)*32+(CANVASX+X)),COUT
1740 NEXT X
1750 NEXT Y
1760 RETURN

REM ------------------------------------------------------------
REM 2000–2999: UI
REM ------------------------------------------------------------
2000 REM === DRAW STATIC UI ===
2010 CLS
2020 LOCATE 0,0:PRINT "MSPAINT-ULTRA";
2030 FOR X=CANVASX-1 TO CANVASX+28
2040 LOCATE X,CANVASY-1:PRINT CHR$(219);
2050 LOCATE X,CANVASY+20:PRINT CHR$(219);
2060 NEXT X
2070 FOR Y=CANVASY-1 TO CANVASY+20
2080 LOCATE CANVASX-1,Y:PRINT CHR$(219);
2090 LOCATE CANVASX+28,Y:PRINT CHR$(219);
2100 NEXT Y
2110 GOSUB 2100
2120 RETURN

2100 REM === DRAW STATUS + LAYER PANEL ===
2110 LOCATE 0,22:PRINT "TOOL:";TOOL;" COL:";COLOR;" BR:";BRUSHPRESET;" LY:";LAYER;
2120 PX=32:PY=2
2130 FOR I=0 TO LAYERS-1
2140 LOCATE PX,PY+I
2150 IF I=LAYER THEN PRINT ">" ELSE PRINT " ";
2160 IF OPACITY(I)=0 THEN PRINT " [ ] " ELSE PRINT " [E] ";
2170 PRINT "L";I;" O";OPACITY(I);
2180 IF BLEND(I)=0 THEN PRINT " N";
2190 IF BLEND(I)=1 THEN PRINT " M";
2200 IF BLEND(I)=2 THEN PRINT " S";
2210 IF BLEND(I)=3 THEN PRINT " O";
2220 NEXT I
2230 RETURN

REM ------------------------------------------------------------
REM 3000–3999: MAIN LOOP
REM ------------------------------------------------------------
3000 REM === MAIN LOOP ===
3010 K$=INKEY$
3020 IF K$="" THEN GOTO 3200

REM === CURSOR MOVEMENT ===
3030 IF K$=CHR$(28) THEN CURX=CURX-1
3040 IF K$=CHR$(29) THEN CURX=CURX+1
3050 IF K$=CHR$(30) THEN CURY=CURY-1
3060 IF K$=CHR$(31) THEN CURY=CURY+1
3070 IF CURX<CANVASX THEN CURX=CANVASX
3080 IF CURX>CANVASX+27 THEN CURX=CANVASX+27
3090 IF CURY<CANVASY THEN CURY=CANVASY
3100 IF CURY>CANVASY+19 THEN CURY=CANVASY+19

REM === TOOL SELECTION ===
3110 IF K$="P" THEN TOOL=0
3120 IF K$="E" THEN TOOL=1
3130 IF K$="F" THEN TOOL=2
3140 IF K$="S" THEN TOOL=3
3150 IF K$="I" THEN TOOL=4
3160 IF K$="R" THEN TOOL=5
3170 IF K$="O" THEN TOOL=6
3180 IF K$>="1" AND K$<="8" THEN COLOR=VAL(K$)

REM === LAYER PANEL ===
3190 IF K$="," THEN LAYER=LAYER-1:IF LAYER<0 THEN LAYER=0
3200 IF K$="." THEN LAYER=LAYER+1:IF LAYER>=LAYERS THEN LAYER=LAYERS-1
3210 IF K$="V" THEN IF OPACITY(LAYER)>0 THEN OPACITY(LAYER)=0 ELSE OPACITY(LAYER)=255
3220 IF K$="B" THEN BLEND(LAYER)=BLEND(LAYER)+1:IF BLEND(LAYER)>3 THEN BLEND(LAYER)=0
3230 IF K$="[" THEN OPACITY(LAYER)=OPACITY(LAYER)-16:IF OPACITY(LAYER)<0 THEN OPACITY(LAYER)=0
3240 IF K$="]" THEN OPACITY(LAYER)=OPACITY(LAYER)+16:IF OPACITY(LAYER)>255 THEN OPACITY(LAYER)=255

REM === BRUSH EDITOR ===
3250 IF K$="K" THEN GOSUB 6000

REM === SELECTION + TRANSFORM ===
3260 IF K$="Q" THEN GOSUB 7020
3270 IF K$="W" THEN GOSUB 7030
3280 IF K$="V" AND SELMODE=0 THEN GOSUB 7040
3290 IF K$=" " AND SELMODE=2 THEN GOSUB 7050
3300 IF K$=CHR$(13) AND SELMODE=2 THEN GOSUB 7060
3310 IF K$="C" THEN GOSUB 7070
3320 IF K$="P" THEN GOSUB 7080
3330 IF K$="F" THEN GOSUB 7090
3340 IF K$="G" THEN GOSUB 7100
3350 IF K$="Z" THEN GOSUB 7110
3360 IF K$="X" THEN GOSUB 7120

REM === UNDO/REDO ===
3370 IF K$="U" THEN GOSUB 9600
3380 IF K$="Y" THEN GOSUB 9900

REM === PROJECT SAVE/LOAD ===
3390 IF K$="H" THEN GOSUB 13000
3400 IF K$="J" THEN GOSUB 13600

REM === DRAW TOOL ===
3410 IF K$=" " AND SELMODE=0 THEN GOSUB 4000

3200 GOSUB 1600
3210 GOSUB 2100
3220 LOCATE CURX,CURY:PRINT CHR$(176);
3230 GOTO 3010
6090 NEXT X
6100 NEXT Y
6110 LOCATE BX+5,BY+5:PRINT CHR$(176);
6120 K$=INKEY$:IF K$="" THEN GOTO 6120
6130 IF K$=CHR$(28) THEN BX=BX-1
6140 IF K$=CHR$(29) THEN BX=BX+1
6150 IF K$=CHR$(30) THEN BY=BY-1
6160 IF K$=CHR$(31) THEN BY=BY+1
6170 IF BX<0 THEN BX=0
6180 IF BX>6 THEN BX=6
6190 IF BY<0 THEN BY=0
6200 IF BY>6 THEN BY=6
6210 IF K$=" " THEN B(BRUSHPRESET,BX,BY)=1-B(BRUSHPRESET,BX,BY)
6220 IF K$=CHR$(13) THEN EXIT WHILE
6230 WEND
6240 CLS:GOSUB 2000
6250 RETURN

REM ------------------------------------------------------------
REM 7000–7999: SELECTION + TRANSFORM
REM ------------------------------------------------------------

7020 REM RECT START
7021 SELMODE=1
7022 SX0=CURX-CANVASX:SY0=CURY-CANVASY
7023 RETURN

7030 REM RECT END
7031 IF SELMODE<>1 THEN RETURN
7032 SX1=CURX-CANVASX:SY1=CURY-CANVASY
7033 IF SX1<SX0 THEN T=SX0:SX0=SX1:SX1=T
7034 IF SY1<SY0 THEN T=SY0:SY0=SY1:SY1=T
7035 GOSUB 7200:SELMODE=0
7036 RETURN

7040 REM LASSO START
7041 SELMODE=2:LCOUNT=0:SELACTIVE=0
7042 RETURN

7050 REM LASSO ADD POINT
7051 IF SELMODE<>2 THEN RETURN
7052 IF LCOUNT>=100 THEN RETURN
7053 LX(LCOUNT)=CURX-CANVASX
7054 LY(LCOUNT)=CURY-CANVASY
7055 LCOUNT=LCOUNT+1
7056 RETURN

7060 REM LASSO COMMIT
7061 IF SELMODE<>2 THEN RETURN
7062 IF LCOUNT<3 THEN SELMODE=0:RETURN
7063 GOSUB 7300:SELMODE=0
7064 RETURN

7070 REM COPY
7071 IF SELACTIVE=0 THEN RETURN
7072 GOSUB 7400:RETURN

7080 REM PASTE
7081 IF COPYW=0 OR COPYH=0 THEN RETURN
7082 GOSUB 7500:RETURN

7090 REM FLIP H
7091 IF COPYW=0 OR COPYH=0 THEN RETURN
7092 GOSUB 7600:RETURN

7100 REM FLIP V
7101 IF COPYW=0 OR COPYH=0 THEN RETURN
7102 GOSUB 7700:RETURN

7110 REM ROTATE
7111 IF COPYW=0 OR COPYH=0 THEN RETURN
7112 GOSUB 7800:RETURN

7120 REM SCALE 2X
7121 IF COPYW=0 OR COPYH=0 THEN RETURN
7122 GOSUB 7900:RETURN

7200 REM RECT MASK
7201 FOR Y=0 TO 19
7202 FOR X=0 TO 27
7203 SEL(X,Y)=0
7204 NEXT X
7205 NEXT Y
7206 FOR Y=SY0 TO SY1
7207 IF Y<0 OR Y>19 THEN GOTO 7214
7208 FOR X=SX0 TO SX1
7209 IF X<0 OR X>27 THEN GOTO 7213
7210 SEL(X,Y)=1
7211 NEXT X
7212 GOTO 7214
7213 NEXT X
7214 NEXT Y
7215 SELACTIVE=1
7216 RETURN

7300 REM LASSO MASK (SCANLINE)
7301 FOR Y=0 TO 19
7302 FOR X=0 TO 27
7303 SEL(X,Y)=0
7304 NEXT X
7305 NEXT Y

7306 FOR Y=0 TO 19
7307 CNT=0
7308 FOR I=0 TO LCOUNT-1
7309 J=I+1:IF J>=LCOUNT THEN J=0
7310 YI=LY(I):YJ=LY(J)
7311 XI=LX(I):XJ=LX(J)
7312 IF (YI<=Y AND YJ>Y) OR (YJ<=Y AND YI>Y) THEN
7313   DY=YJ-YI
7314   IF DY<>0 THEN
7315     XINT = XI + (Y-YI)*(XJ-XI)/DY
7316     IF CNT<100 THEN XINTS(CNT)=XINT:CNT=CNT+1
7317   END IF
7318 END IF
7319 NEXT I

7320 FOR A=0 TO CNT-2
7321 FOR B=A+1 TO CNT-1
7322 IF XINTS(B)<XINTS(A) THEN T=XINTS(A):XINTS(A)=XINTS(B):XINTS(B)=T
7323 NEXT B
7324 NEXT A

7325 FOR K=0 TO CNT-2 STEP 2
7326 X0=XINTS(K):X1=XINTS(K+1)
7327 IF X0<0 THEN X0=0
7328 IF X1>27 THEN X1=27
7329 FOR X=X0 TO X1
7330 SEL(X,Y)=1
7331 NEXT X
7332 NEXT K
7333 NEXT Y

7334 SELACTIVE=1
7335 RETURN

7400 REM CAPTURE TO COPY BUFFER
7401 SX0=27:SY0=19:SX1=0:SY1=0
7402 FOR Y=0 TO 19
7403 FOR X=0 TO 27
7404 IF SEL(X,Y)=1 THEN
7405   COPY(X,Y)=L(LAYER,X,Y)
7406   IF X<SX0 THEN SX0=X
7407   IF Y<SY0 THEN SY0=Y
7408   IF X>SX1 THEN SX1=X
7409   IF Y>SY1 THEN SY1=Y
7410 ELSE
7411   COPY(X,Y)=0
7412 END IF
7413 NEXT X
7414 NEXT Y

7415 IF SX1<SX0 OR SY1<SY0 THEN COPYW=0:COPYH=0:RETURN
7416 COPYW=SX1-SX0
7417 COPYH=SY1-SY0
7418 RETURN

7500 REM PASTE COPY BUFFER
7501 DX=CURX-CANVASX
7502 DY=CURY-CANVASY
7503 FOR Y=0 TO COPYH
7504 YY=DY+Y
7505 IF YY<0 OR YY>19 THEN GOTO 7513
7506 FOR X=0 TO COPYW
7507 XX=DX+X
7508 IF XX<0 OR XX>27 THEN GOTO 7512
7509 C=COPY(SX0+X,SY0+Y)
7510 IF C<>0 THEN L(LAYER,XX,YY)=C
7511 NEXT X
7512 NEXT X
7513 NEXT Y
7514 RETURN

7600 REM FLIP HORIZONTAL
7601 FOR Y=SY0 TO SY1
7602 FOR X=SX0 TO (SX0+SX1)\2
7603 NX=SX1-(X-SX0)
7604 T=COPY(X,Y)
7605 COPY(X,Y)=COPY(NX,Y)
7606 COPY(NX,Y)=T
7607 NEXT X
7608 NEXT Y
7609 RETURN

7700 REM FLIP VERTICAL
7701 FOR Y=SY0 TO (SY0+SY1)\2
7702 NY=SY1-(Y-SY0)
7703 FOR X=SX0 TO SX1
7704 T=COPY(X,Y)
7705 COPY(X,Y)=COPY(X,NY)
7706 COPY(X,NY)=T
7707 NEXT X
7708 NEXT Y
7709 RETURN

7800 REM ROTATE 90 DEGREES
7801 DIM TMP(27,19)
7802 W=COPYW:H=COPYH
7803 FOR Y=0 TO H
7804 FOR X=0 TO W
7805 C=COPY(SX0+X,SY0+Y)
7806 NX=SX0+(H-Y)
7807 NY=SY0+X
7808 TMP(NX,NY)=C
7809 NEXT X
7810 NEXT Y

7811 FOR Y=SY0 TO SY1
7812 FOR X=SX0 TO SX1
7813 COPY(X,Y)=TMP(X,Y)
7814 NEXT X
7815 NEXT Y

7816 T=COPYW:COPYW=COPYH:COPYH=T
7817 RETURN

7900 REM SCALE 2X
7901 FOR Y=SY1 TO SY0 STEP -1
7902 FOR X=SX1 TO SX0 STEP -1
7903 C=COPY(X,Y)
7904 NX=SX0+(X-SX0)*2
7905 NY=SY0+(Y-SY0)*2
7906 IF NX>=0 AND NX+1<=27 AND NY>=0 AND NY+1<=19 THEN
7907   COPY(NX,NY)=C
7908   COPY(NX+1,NY)=C
7909   COPY(NX,NY+1)=C
7910   COPY(NX+1,NY+1)=C
7911 END IF
7912 NEXT X
7913 NEXT Y

7914 COPYW=COPYW*2
7915 COPYH=COPYH*2
7916 RETURN
REM ------------------------------------------------------------
REM 9000–9999: UNDO / REDO SYSTEM
REM ------------------------------------------------------------

9000 REM === PIXEL WRITE + DELTA LOG ===
9010 OC=L(LAYER,LX-CANVASX,LY-CANVASY)
9020 IF OC=NC THEN RETURN
9030 CIDX=UCOUNT(UNDOPTR)
9040 IF CIDX<MAXD THEN
9050   UX(UNDOPTR,CIDX)=LX
9060   UY(UNDOPTR,CIDX)=LY
9070   UOLD(UNDOPTR,CIDX)=OC
9080   UNEW(UNDOPTR,CIDX)=NC
9090   UCOUNT(UNDOPTR)=CIDX+1
9100 END IF
9110 RETURN

9400 REM === START NEW UNDO RECORD ===
9410 UNDOPTR=(UNDOPTR+1) MOD UNDOLEVELS
9420 UCOUNT(UNDOPTR)=0
9430 REDOPTR=UNDOPTR
9440 RETURN

9600 REM === UNDO OPERATION ===
9610 C=UCOUNT(UNDOPTR)
9620 IF C=0 THEN RETURN

9630 REDOPTR=(REDOPTR+1) MOD UNDOLEVELS
9640 RCOUNT(REDOPTR)=C

9650 FOR I=0 TO C-1
9660   RX(REDOPTR,I)=UX(UNDOPTR,I)
9670   RY(REDOPTR,I)=UY(UNDOPTR,I)
9680   ROLD(REDOPTR,I)=UNEW(UNDOPTR,I)
9690   RNEW(REDOPTR,I)=UOLD(UNDOPTR,I)
9700 NEXT I

9710 FOR I=0 TO C-1
9720   LX=UX(UNDOPTR,I)
9730   LY=UY(UNDOPTR,I)
9740   XX=LX-CANVASX
9750   YY=LY-CANVASY
9760   L(LAYER,XX,YY)=UOLD(UNDOPTR,I)
9770 NEXT I

9780 UNDOPTR=(UNDOPTR-1+UNDOLEVELS) MOD UNDOLEVELS
9790 RETURN

9900 REM === REDO OPERATION ===
9910 C=RCOUNT(REDOPTR)
9920 IF C=0 THEN RETURN

9930 UNDOPTR=(UNDOPTR+1) MOD UNDOLEVELS
9940 UCOUNT(UNDOPTR)=C

9950 FOR I=0 TO C-1
9960   UX(UNDOPTR,I)=RX(REDOPTR,I)
9970   UY(UNDOPTR,I)=RY(REDOPTR,I)
9980   UOLD(UNDOPTR,I)=ROLD(REDOPTR,I)
9990   UNEW(UNDOPTR,I)=RNEW(REDOPTR,I)
10000 NEXT I

10010 FOR I=0 TO C-1
10020   LX=RX(REDOPTR,I)
10030   LY=RY(REDOPTR,I)
10040   XX=LX-CANVASX
10050   YY=LY-CANVASY
10060   L(LAYER,XX,YY)=RNEW(REDOPTR,I)
10070 NEXT I

10080 REDOPTR=(REDOPTR-1+UNDOLEVELS) MOD UNDOLEVELS
10090 RETURN

REM ------------------------------------------------------------
REM 13000–13999: PROJECT SAVE / LOAD (VERSIONED)
REM ------------------------------------------------------------

13000 REM === SAVE FULL PROJECT ===
13010 PRINT "PROJ:BEGIN;";
13020 PRINT "PROJ:INFO=";VERSION;",";LAYERS;",";28;",";20;",";FLAGS;";";

13030 REM SAVE LAYERS
13040 FOR LID=0 TO LAYERS-1
13050 FOR Y=0 TO 19
13060 FOR X=0 TO 27
13070 C=L(LID,X,Y)
13080 IF C<>0 THEN PRINT "PROJ:LAYER=";LID;",";X;",";Y;",";C;";";
13090 NEXT X
13100 NEXT Y
13110 NEXT LID

13120 REM SAVE BRUSHES
13130 FOR P=0 TO BRUSHES-1
13140 FOR Y=0 TO 6
13150 FOR X=0 TO 6
13160 V=B(P,X,Y)
13170 IF V<>0 THEN PRINT "PROJ:BRUSH=";P;",";X;",";Y;",";V;";";
13180 NEXT X
13190 NEXT Y
13200 NEXT P

13210 REM SAVE UNDO RING
13220 PRINT "PROJ:UNDO:PTR=";UNDOPTR;";REDO=";REDOPTR;";";
13230 FOR L=0 TO UNDOLEVELS-1
13240 C=UCOUNT(L)
13250 PRINT "PROJ:UNDO:LEVEL=";L;";COUNT=";C;";";
13260 FOR I=0 TO C-1
13270 PRINT "PROJ:UNDO:DELTA=";L;",";I;",";UX(L,I);",";UY(L,I);",";UOLD(L,I);",";UNEW(L,I);";";
13280 NEXT I
13290 NEXT L

13300 REM SAVE SELECTION
13310 PRINT "PROJ:SEL:ACTIVE=";SELACTIVE;";";
13320 IF SELACTIVE=1 THEN
13330 FOR Y=0 TO 19
13340 FOR X=0 TO 27
13350 IF SEL(X,Y)=1 THEN PRINT "PROJ:SEL:PIX=";X;",";Y;",1;";
13360 NEXT X
13370 NEXT Y
13380 END IF

13390 REM SAVE COPY BUFFER
13400 PRINT "PROJ:COPY:BOUNDS=";SX0;",";SY0;",";SX1;",";SY1;";";
13410 FOR Y=SY0 TO SY1
13420 FOR X=SX0 TO SX1
13430 C=COPY(X,Y)
13440 IF C<>0 THEN PRINT "PROJ:COPY:PIX=";X;",";Y;",";C;";";
13450 NEXT X
13460 NEXT Y

13470 PRINT "PROJ:END;";
13480 RETURN

13600 REM === REQUEST PROJECT LOAD ===
13610 PRINT "PROJ:REQ=1;";
13620 RETURN
